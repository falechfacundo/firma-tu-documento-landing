---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showcase from '../components/Showcase.astro';
import Bento from '../components/Bento.astro';
import Flow from '../components/Flow.astro';
import Details from '../components/Details.astro';
import CTA from '../components/CTA.astro';
import type { Lang } from '../i18n/routes';
import { APP_URL, SITE_NAME } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = {
  es: {
    title: 'Firma tu Documento — Firma electrónica y gestión de acuerdos',
    description: 'Prepará documentos, reuní firmas electrónicas, gestioná aprobaciones y seguí acuerdos con sus evidencias en un solo espacio.',
    desc: 'Plataforma web para firma electrónica, flujos de aprobación, gestión documental y seguimiento de acuerdos.',
  },
  en: {
    title: 'Firma tu Documento — Electronic signatures and agreement management',
    description: 'Prepare documents, collect electronic signatures, manage approvals and follow agreements with their evidence in one workspace.',
    desc: 'Web platform for electronic signatures, approval workflows, document management and agreement follow-up.',
  },
}[lang];
const ld = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: SITE_NAME, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: meta.desc, url: APP_URL },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(lang === 'es' ? '/' : '/en/', Astro.site).href, inLanguage: lang },
];
---
<Layout title={meta.title} description={meta.description} lang={lang} routeKey="home" jsonLd={ld}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Showcase lang={lang} />
  <Bento lang={lang} />
  <Flow lang={lang} />
  <Details lang={lang} />
  <CTA lang={lang} />
</Layout>
