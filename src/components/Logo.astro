---
interface Props { size?: number; word?: boolean; class?: string; animate?: boolean }
const { size = 28, word = true, class: cls = '', animate = false } = Astro.props;
---
<span class={`inline-flex items-center gap-[0.55em] ${cls}`} style={`font-size:${size}px`}>
  <svg viewBox="0 0 32 32" style="height:1em;width:1em;overflow:visible" fill="none" aria-hidden="true" class={animate ? 'logo-anim' : ''}>
    <path d="M8 3.75h10l6 6v17.5H8a2 2 0 0 1-2-2v-19.5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    <path d="M18 4v6h6M10.5 15.25h10M10.5 19h5.25M10.5 23c2.7-2.5 3.6 1.7 5.2-.3 1.1-1.4 2.3-2.4 3.8-1.7 1 .5 1.5.2 2.1-.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {word && <span class="font-semibold tracking-[-0.045em] leading-none" style="font-size:.78em">Firma tu Documento</span>}
  {!word && <span class="sr-only">Firma tu Documento</span>}
</span>
