---
import Icon from './Icon.astro';
import { REGISTER_URL, LOGIN_URL } from '../config';
import { home } from '../i18n/home';
import type { Lang } from '../i18n/routes';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const c = home[lang].cta;
---
<section id="empezar" class="section pb-32" data-cta>
  <div class="wrap-wide">
    <div class="cta noise relative overflow-hidden rounded-[2.2rem] px-6 py-24 text-center sm:px-12 md:py-32">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="hairline-grid absolute inset-0 [mask-image:radial-gradient(60%_70%_at_50%_100%,#000,transparent)]"></div>
        <div class="absolute left-1/2 top-[60%] h-[70%] w-[80%] -translate-x-1/2 rounded-full bg-accent/50 blur-[110px]"></div>
      </div>

      <svg class="cta-mark relative mx-auto mb-10 h-16 w-auto text-white" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="overflow:visible">
        <path data-cta-leaf="a" d="M8 3.75h10l6 6v17.5H8a2 2 0 0 1-2-2v-19.5a2 2 0 0 1 2-2Z" />
        <path data-cta-leaf="b" d="M18 4v6h6M10.5 15.25h10M10.5 19h5.25" />
        <path data-cta-leaf="c" d="M10.5 23c2.7-2.5 3.6 1.7 5.2-.3 1.1-1.4 2.3-2.4 3.8-1.7 1 .5 1.5.2 2.1-.4" />
      </svg>

      <h2 class="h-display relative mx-auto max-w-[16ch] grad-text" style="font-size:clamp(2.6rem,7vw,5.4rem)" data-reveal>{c.h2}</h2>
      <p class="lead relative mx-auto mt-7 max-w-[32rem]" data-reveal>{c.lead}</p>
      <div class="relative mt-11 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal>
        <a href={REGISTER_URL} data-magnetic class="btn btn-primary btn-lg">{c.primary} <Icon name="arrow-right" class="arrow" /></a>
        <a href={LOGIN_URL} data-magnetic class="btn btn-ghost btn-lg">{c.secondary}</a>
      </div>
    </div>
  </div>
</section>
